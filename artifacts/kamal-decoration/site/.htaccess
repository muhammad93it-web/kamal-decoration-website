# KAMAL DECORATION — Apache configuration (Namecheap shared hosting compatible)
Options -Indexes
AddDefaultCharset UTF-8

# ───── Clean URLs ─────
<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS (uncomment after SSL is enabled in cPanel)
# RewriteCond %{HTTPS} !=on
# RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

RewriteRule ^p/([A-Za-z0-9._-]+)/?$ resolve.php?code=$1 [L,QSA]
RewriteRule ^palette/([^/]+)/?$ palette.php?slug=$1 [L,QSA]
RewriteRule ^shade/([^/]+)/?$ shade.php?slug=$1 [L,QSA]
RewriteRule ^product/([^/]+)/?$ product.php?slug=$1 [L,QSA]
RewriteRule ^project/([^/]+)/?$ project.php?slug=$1 [L,QSA]
RewriteRule ^post/([^/]+)/?$ post.php?slug=$1 [L,QSA]
RewriteRule ^category/([^/]+)/?$ products.php?category=$1 [L,QSA]
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Block the installer once installation is complete (lock file exists).
# Best-effort at webserver level; install/index.php also refuses on its own.
RewriteCond %{REQUEST_URI} (^|/)install(/|$)
RewriteCond %{DOCUMENT_ROOT}/config/install.lock -f
RewriteRule ^ - [F]

# Extensionless pages: /products → products.php (mirrors dev router)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^([a-z0-9_-]+)/?$ $1.php [L,QSA]
</IfModule>

# ───── Protect sensitive files and folders ─────
RedirectMatch 403 ^/(config|includes|templates|lang|libraries|logs|backups|tools)(/|$)
<Files "database.sql">
  <IfModule mod_authz_core.c>Require all denied</IfModule>
  <IfModule !mod_authz_core.c>Deny from all</IfModule>
</Files>
<FilesMatch "^(composer\.(json|lock)|config\.example\.php|\.env.*)$">
  <IfModule mod_authz_core.c>Require all denied</IfModule>
  <IfModule !mod_authz_core.c>Deny from all</IfModule>
</FilesMatch>

# ───── Browser caching ─────
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType image/jpeg "access plus 30 days"
ExpiresByType image/png "access plus 30 days"
ExpiresByType image/webp "access plus 30 days"
ExpiresByType image/gif "access plus 30 days"
ExpiresByType image/svg+xml "access plus 30 days"
ExpiresByType font/woff2 "access plus 365 days"
ExpiresByType text/css "access plus 7 days"
ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# ───── Compression ─────
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ───── Security headers ─────
<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set X-Frame-Options "SAMEORIGIN"
Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
